generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MessageSender {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  SENT
  FAILED
}

enum FileProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(255)
  slug        String             @unique @db.VarChar(100)
  description String?            @db.Text
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  users User[]
  conversations Conversation[]
  files OrganizationFile[]
  fileProcessingJobs FileProcessingJob[]

  @@index([status])
  @@index([deletedAt])
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  email          String         @unique @db.VarChar(255)
  passwordHash   String         @db.VarChar(255)
  firstName      String         @db.VarChar(100)
  lastName       String         @db.VarChar(100)
  status         UserStatus     @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  sessions       Session[]
  conversations  Conversation[]
  conversationParticipants ConversationParticipant[]
  roles          UserRole[]
  uploadedFiles  OrganizationFile[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([organizationId, deletedAt, createdAt])
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  refreshTokenHash String        @db.VarChar(255)
  userAgent        String?       @db.Text
  ipAddress        String?       @db.VarChar(45)
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
  @@index([status, revokedAt, createdAt])
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  userId         String             @db.Uuid
  title          String             @db.VarChar(255)
  status         ConversationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  messages       Message[]
  participants   ConversationParticipant[]

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([organizationId, deletedAt, createdAt])
  @@index([userId, deletedAt, createdAt])
}

model ConversationParticipant {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  sender         MessageSender
  content        String        @db.Text
  status         MessageStatus @default(SENT)
  tokenCount     Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([sender])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([conversationId, deletedAt, createdAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  users       UserRole[]
  permissions RolePermission[]

  @@index([deletedAt])
  @@index([createdAt])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([name])
  @@index([createdAt])
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model OrganizationFile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  uploadedById   String   @db.Uuid
  originalName   String   @db.VarChar(255)
  storageKey     String   @unique @db.VarChar(500)
  mimeType       String   @db.VarChar(100)
  extension      String   @db.VarChar(20)
  size           Int
  sha256         String   @db.VarChar(64)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  processingJob FileProcessingJob?

  @@index([sha256])
  @@index([organizationId, deletedAt, createdAt])
}

model FileProcessingJob {
  id             String               @id @default(uuid()) @db.Uuid
  fileId         String               @unique @db.Uuid
  organizationId String               @db.Uuid

  status         FileProcessingStatus @default(PENDING)
  correlationId  String               @unique @db.Uuid
  attempts       Int                  @default(0)

  totalQuantity  Int?
  totalRevenue   Decimal?             @db.Decimal(12, 2)
  errorMessage   String?              @db.Text

  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  file           OrganizationFile     @relation(fields: [fileId], references: [id])
  organization   Organization         @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status, createdAt])
  @@index([status])
  @@index([correlationId])
  }
